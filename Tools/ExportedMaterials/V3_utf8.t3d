   Begin Object Name="MaterialExpressionCustom_2" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Tests/Realistic_Water/V3_GodotInspiredFlow/V3_M_RealisticWater_GodotInspired.V3_M_RealisticWater_GodotInspired:MaterialExpressionCustom_2'"
      Code="float3 positionDx = ddx(WorldPosition);\nfloat3 positionDy = ddy(WorldPosition);\nfloat3 geometricNormal = normalize(cross(positionDx, positionDy));\ngeometricNormal *= geometricNormal.z < 0.0 ? -1.0 : 1.0;\nfloat2 slope = -geometricNormal.xy / max(geometricNormal.z, 0.12);\nreturn saturate(length(slope) * SlopeScale);"
      OutputType=CMOT_Float1
      Description="V2 displaced-surface slope amount"
      Inputs(0)=(InputName="WorldPosition",Input=(Expression="/Script/Engine.MaterialExpressionWorldPosition'V3_M_RealisticWater_GodotInspired:MaterialExpressionWorldPosition_0'",Mask=1,MaskR=1,MaskG=1,MaskB=1))

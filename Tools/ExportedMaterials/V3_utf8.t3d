   End Object
   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Tests/Realistic_Water/V3_GodotInspiredFlow/V3_M_RealisticWater_GodotInspired.V3_M_RealisticWater_GodotInspired:MaterialExpressionCustom_0'"
      Code="// CalculateWaterRipples\r\nfloat TotalHeight = 0.0;\r\n\r\nfor (int i = 0; i < 32; ++i)\r\n{\r\n    // Row 0: Origin.X, Origin.Y, StartTime, InitialAmplitude (RGBA 순서)\r\n    float4 Row1 = RippleTex.Load(int3(i, 0, 0));\r\n    \r\n    // Row 1: WaveSpeed, DecayRate, WaveLength, ExpireTime (RGBA 순서)\r\n    float4 Row2 = RippleTex.Load(int3(i, 1, 0));\r\n    \r\n    float2 Origin = Row1.xy;\r\n    float StartTime = Row1.z;\r\n    float InitialAmplitude = Row1.w;\r\n    \r\n    float WaveSpeed = Row2.x;\r\n    float DecayRate = Row2.y;\r\n    float WaveLength = Row2.z;\r\n    float ExpireTime = Row2.w;\r\n    \r\n    // 비활성화된 슬롯이거나 이미 소멸 시간이 지난 파동은 즉시 컬링\r\n    if (InitialAmplitude <= 0.0 || ServerTime >= ExpireTime)\r\n    {\r\n        continue;\r\n    }\r\n    \r\n    float dt = ServerTime - StartTime;\r\n    if (dt < 0.0)\r\n    {\r\n        continue;\r\n    }\r\n    \r\n    // 거리 및 파동 전파 위치(선두) 계산\r\n    float d = distance(WorldPos, Origin);\r\n    float R = WaveSpeed * dt;\r\n    float W = WaveLength * 2.0; // 파동의 반치 폭\r\n    \r\n    // Bounding 영역 컬링: 선두 전파 범위 밖의 정점 연산 제외\r\n    if (d > R + W || (R > W && d < R - W))\r\n    {\r\n        continue;\r\n    }\r\n    \r\n    // 시간 경과에 따른 진폭 감쇄 계산\r\n    float Decay = exp(-DecayRate * dt);\r\n    \r\n    // 선두(Wavefront)와의 거리에 따른 감쇄 영역(Envelope) 계산\r\n    float DistFromWavefront = abs(d - R);\r\n    float Envelope = 1.0 - smoothstep(0.0, W, DistFromWavefront);\r\n    \r\n    // 파동 위상(Phase) 및 코사인 파형 계산\r\n    float Phase = (d - R) / WaveLength * 2.0 * 3.141592;\r\n    float Height = InitialAmplitude * Decay * cos(Phase) * Envelope;\r\n    \r\n    TotalHeight += Height;\r\n}\r\n\r\nreturn TotalHeight;\r\n"
      OutputType=CMOT_Float1
      Inputs(0)=(InputName="RippleTex",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'V3_M_RealisticWater_GodotInspired:MaterialExpressionTextureObjectParameter_0'"))
      Inputs(1)=(InputName="WorldPos",Input=(Expression="/Script/Engine.MaterialExpressionWorldPosition'V3_M_RealisticWater_GodotInspired:MaterialExpressionWorldPosition_1'",OutputIndex=1,Mask=1,MaskR=1,MaskG=1))
      Inputs(2)=(InputName="ServerTime",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'V3_M_RealisticWater_GodotInspired:MaterialExpressionScalarParameter_2'"))
      ShowCode=True
      MaterialExpressionEditorX=5616
      MaterialExpressionEditorY=272
      MaterialExpressionGuid=6989327143DAB5044DF30BA1847D775B
      Material="/Script/Engine.Material'V3_M_RealisticWater_GodotInspired'"
   End Object
   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Tests/Realistic_Water/V3_GodotInspiredFlow/V3_M_RealisticWater_GodotInspired.V3_M_RealisticWater_GodotInspired:MaterialExpressionCustom_1'"
      Code="float3 positionDx = ddx(WorldPosition);\nfloat3 positionDy = ddy(WorldPosition);\nfloat3 geometricNormal = normalize(cross(positionDx, positionDy));\ngeometricNormal *= geometricNormal.z < 0.0 ? -1.0 : 1.0;\nfloat2 slope = -geometricNormal.xy / max(geometricNormal.z, 0.12);\nfloat2 p = WorldPosition.xy * 0.000055;\nfloat t = TimeSeconds * 0.065;\nfloat2 wandering = float2(\n    sin(p.y * 2.7 + cos(p.x * 1.3 + t) + t * 0.7),\n    cos(p.x * 2.1 + sin(p.y * 1.7 - t * 0.8) - t * 0.55));\nwandering = normalize(wandering + float2(1.0e-5, 0.0));\nfloat2 dominant = normalize(DominantFlow.xy + float2(1.0e-5, 0.0));\nfloat2 flow = normalize(dominant + slope * SlopeInfluence + wandering * Turbulence);\nreturn flow;"
      OutputType=CMOT_Float2
      Description="V2 displaced-surface slope, evolving flow, and world-normalized curvature"
      Inputs(0)=(InputName="WorldPosition",Input=(Expression="/Script/Engine.MaterialExpressionWorldPosition'V3_M_RealisticWater_GodotInspired:MaterialExpressionWorldPosition_0'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(1)=(InputName="TimeSeconds",Input=(Expression="/Script/Engine.MaterialExpressionTime'V3_M_RealisticWater_GodotInspired:MaterialExpressionTime_0'"))
      Inputs(2)=(InputName="DominantFlow",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'V3_M_RealisticWater_GodotInspired:MaterialExpressionVectorParameter_1'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(3)=(InputName="SlopeInfluence",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'V3_M_RealisticWater_GodotInspired:MaterialExpressionScalarParameter_5'"))
      Inputs(4)=(InputName="Turbulence",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'V3_M_RealisticWater_GodotInspired:MaterialExpressionScalarParameter_6'"))
      Inputs(5)=(InputName="SlopeScale",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'V3_M_RealisticWater_GodotInspired:MaterialExpressionScalarParameter_7'"))
      Inputs(6)=(InputName="CurvatureScaleCm",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'V3_M_RealisticWater_GodotInspired:MaterialExpressionScalarParameter_8'"))
      MaterialExpressionEditorX=-2700
      MaterialExpressionEditorY=-1080
      MaterialExpressionGuid=1951F4BD48A73B79A13B14B8953B7828
      Material="/Script/Engine.Material'V3_M_RealisticWater_GodotInspired'"
      Desc="V2 displaced-surface slope, evolving flow, and world-normalized curvature"
   End Object
   Begin Object Name="MaterialExpressionCustom_10" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Tests/Realistic_Water/V3_GodotInspiredFlow/V3_M_RealisticWater_GodotInspired.V3_M_RealisticWater_GodotInspired:MaterialExpressionCustom_10'"
      Code="float angle = CrossAngle * 0.0174532925199433;\nfloat sineValue; float cosineValue; sincos(angle, sineValue, cosineValue);\nfloat2 direction = normalize(Flow + float2(1.0e-5, 0.0));\ndirection = float2(direction.x * cosineValue - direction.y * sineValue, direction.x * sineValue + direction.y * cosineValue);\nfloat phaseValue = frac(TimeSeconds * CycleRate + 0.5);\nfloat localTravel = TravelUV * lerp(0.82, 1.18, SlopeAmount);\nfloat2 across = float2(-direction.y, direction.x);\nfloat slowTime = TimeSeconds * CycleRate;\nfloat2 fieldUV = BaseUV * float2(0.37, 0.29);\nfloat2 motionField = float2(\n    sin(fieldUV.y * 6.7 + sin(fieldUV.x * 3.1 - slowTime * 1.7) + slowTime),\n    cos(fieldUV.x * 5.3 + cos(fieldUV.y * 4.2 + slowTime * 1.3) - slowTime * 0.83));\nmotionField += 0.5 * float2(\n    cos(fieldUV.y * 11.1 - fieldUV.x * 2.7 + slowTime * 0.61),\n    sin(fieldUV.x * 9.4 + fieldUV.y * 3.3 - slowTime * 0.72));\nfloat warpStrength = lerp(0.008, 0.020, SlopeAmount);\nfloat breathing = sin((dot(BaseUV, across) + slowTime * 0.17) * 6.2831853);\nfloat2 evolvingUV = BaseUV + motionField * warpStrength + across * breathing * (0.010 * SlopeAmount);\nreturn evolvingUV - direction * phaseValue * localTravel;"
      OutputType=CMOT_Float2
      Description="V2 Meso: flow phase B"
      Inputs(0)=(InputName="BaseUV",Input=(Expression="/Script/Engine.MaterialExpressionMultiply'V3_M_RealisticWater_GodotInspired:MaterialExpressionMultiply_9'"))
      Inputs(1)=(InputName="Flow",Input=(Expression="/Script/Engine.MaterialExpressionCustom'V3_M_RealisticWater_GodotInspired:MaterialExpressionCustom_1'"))
      Inputs(2)=(InputName="SlopeAmount",Input=(Expression="/Script/Engine.MaterialExpressionCustom'V3_M_RealisticWater_GodotInspired:MaterialExpressionCustom_2'"))
      Inputs(3)=(InputName="TimeSeconds",Input=(Expression="/Script/Engine.MaterialExpressionTime'V3_M_RealisticWater_GodotInspired:MaterialExpressionTime_0'"))
      Inputs(4)=(InputName="CycleRate",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'V3_M_RealisticWater_GodotInspired:MaterialExpressionScalarParameter_22'"))
      Inputs(5)=(InputName="TravelUV",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'V3_M_RealisticWater_GodotInspired:MaterialExpressionScalarParameter_23'"))
      Inputs(6)=(InputName="CrossAngle",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'V3_M_RealisticWater_GodotInspired:MaterialExpressionScalarParameter_24'"))
      MaterialExpressionEditorX=-1550
      MaterialExpressionEditorY=-660
      MaterialExpressionGuid=D1A008B1415EA50D215EC9A086A0D3C2
      Material="/Script/Engine.Material'V3_M_RealisticWater_GodotInspired'"
      Desc="V3 Meso: warped phase B"
   End Object
   Begin Object Name="MaterialExpressionCustom_11" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Tests/Realistic_Water/V3_GodotInspiredFlow/V3_M_RealisticWater_GodotInspired.V3_M_RealisticWater_GodotInspired:MaterialExpressionCustom_11'"
      Code="const float angle = -37.00000000 * 0.0174532925199433;\nfloat sineValue; float cosineValue;\nsincos(angle, sineValue, cosineValue);\nreturn float2(WorldXY.x * cosineValue - WorldXY.y * sineValue, WorldXY.x * sineValue + WorldXY.y * cosineValue);"
      OutputType=CMOT_Float2
      Description="V2 Micro: stable rotated base coordinates"
      Inputs(0)=(InputName="WorldXY",Input=(Expression="/Script/Engine.MaterialExpressionComponentMask'V3_M_RealisticWater_GodotInspired:MaterialExpressionComponentMask_0'"))

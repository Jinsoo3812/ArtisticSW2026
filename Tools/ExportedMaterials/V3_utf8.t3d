   Begin Object Name="MaterialExpressionCustom_3" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Tests/Realistic_Water/V3_GodotInspiredFlow/V3_M_RealisticWater_GodotInspired.V3_M_RealisticWater_GodotInspired:MaterialExpressionCustom_3'"
      Code="float3 positionDx = ddx(WorldPosition);\nfloat3 positionDy = ddy(WorldPosition);\nfloat3 geometricNormal = normalize(cross(positionDx, positionDy));\ngeometricNormal *= geometricNormal.z < 0.0 ? -1.0 : 1.0;\nfloat curvaturePerCm = length(ddx(geometricNormal)) / max(length(positionDx), 1.0e-3) + length(ddy(geometricNormal)) / max(length(positionDy), 1.0e-3);\nreturn saturate(curvaturePerCm * CurvatureScaleCm);"

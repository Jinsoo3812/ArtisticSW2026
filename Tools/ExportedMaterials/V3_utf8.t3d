   Begin Object Name="MaterialExpressionCustom_13" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Tests/Realistic_Water/V3_GodotInspiredFlow/V3_M_RealisticWater_GodotInspired.V3_M_RealisticWater_GodotInspired:MaterialExpressionCustom_13'"
      Code="float angle = CrossAngle * 0.0174532925199433;\nfloat sineValue; float cosineValue; sincos(angle, sineValue, cosineValue);\nfloat2 direction = normalize(Flow + float2(1.0e-5, 0.0));\ndirection = float2(direction.x * cosineValue - direction.y * sineValue, direction.x * sineValue + direction.y * cosineValue);\nfloat phaseValue = frac(TimeSeconds * CycleRate + 0.5);\nfloat localTravel = TravelUV * lerp(0.82, 1.18, SlopeAmount);\nfloat2 across = float2(-direction.y, direction.x);\nfloat slowTime = TimeSeconds * CycleRate;\nfloat2 fieldUV = BaseUV * float2(0.37, 0.29);\nfloat2 motionField = float2(\n    sin(fieldUV.y * 6.7 + sin(fieldUV.x * 3.1 - slowTime * 1.7) + slowTime),\n    cos(fieldUV.x * 5.3 + cos(fieldUV.y * 4.2 + slowTime * 1.3) - slowTime * 0.83));\nmotionField += 0.5 * float2(\n    cos(fieldUV.y * 11.1 - fieldUV.x * 2.7 + slowTime * 0.61),\n    sin(fieldUV.x * 9.4 + fieldUV.y * 3.3 - slowTime * 0.72));\nfloat warpStrength = lerp(0.008, 0.020, SlopeAmount);\nfloat breathing = sin((dot(BaseUV, across) + slowTime * 0.17) * 6.2831853);\nfloat2 evolvingUV = BaseUV + motionField * warpStrength + across * breathing * (0.010 * SlopeAmount);\nreturn evolvingUV - direction * phaseValue * localTravel;"
      OutputType=CMOT_Float2
      Description="V2 Micro: flow phase B"
      Inputs(0)=(InputName="BaseUV",Input=(Expression="/Script/Engine.MaterialExpressionMultiply'V3_M_RealisticWater_GodotInspired:MaterialExpressionMultiply_15'"))
      Inputs(1)=(InputName="Flow",Input=(Expression="/Script/Engine.MaterialExpressionCustom'V3_M_RealisticWater_GodotInspired:MaterialExpressionCustom_1'"))
      Inputs(2)=(InputName="SlopeAmount",Input=(Expression="/Script/Engine.MaterialExpressionCustom'V3_M_RealisticWater_GodotInspired:MaterialExpressionCustom_2'"))
      Inputs(3)=(InputName="TimeSeconds",Input=(Expression="/Script/Engine.MaterialExpressionTime'V3_M_RealisticWater_GodotInspired:MaterialExpressionTime_0'"))
      Inputs(4)=(InputName="CycleRate",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'V3_M_RealisticWater_GodotInspired:MaterialExpressionScalarParameter_31'"))
      Inputs(5)=(InputName="TravelUV",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'V3_M_RealisticWater_GodotInspired:MaterialExpressionScalarParameter_32'"))
      Inputs(6)=(InputName="CrossAngle",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'V3_M_RealisticWater_GodotInspired:MaterialExpressionScalarParameter_33'"))
      MaterialExpressionEditorX=-1550
      MaterialExpressionEditorY=100
      MaterialExpressionGuid=C6068FCF40D2978AD30C209FF3B5E871
      Material="/Script/Engine.Material'V3_M_RealisticWater_GodotInspired'"

   End Object
   Begin Object Name="MaterialExpressionCustom_14" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Tests/Realistic_Water/V3_GodotInspiredFlow/V3_M_RealisticWater_GodotInspired.V3_M_RealisticWater_GodotInspired:MaterialExpressionCustom_14'"
      Code="float3 positionDx = ddx(WorldPosition);\nfloat3 positionDy = ddy(WorldPosition);\nfloat3 geometricNormal = normalize(cross(positionDx, positionDy));\ngeometricNormal *= geometricNormal.z < 0.0 ? -1.0 : 1.0;\nfloat3 tangentX = normalize(float3(max(geometricNormal.z, 1.0e-4), 0.0, -geometricNormal.x));\nfloat3 tangentY = normalize(cross(geometricNormal, tangentX));\nfloat3 result = normalize(tangentX * DetailNormal.x + tangentY * DetailNormal.y + geometricNormal * max(DetailNormal.z, 1.0e-4));\nreturn float4(result, 0.0);"
      OutputType=CMOT_Float4
      Description="V3 displaced-wave basis plus detail normal"

   Begin Object Name="MaterialExpressionCustom_10" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Tests/Realistic_Water/V5_PersistentAdvectedFoam/V5_M_FoamStateUpdate.V5_M_FoamStateUpdate:MaterialExpressionCustom_10'"
      Code="float2 lower = step(0.0, UV);\nfloat2 upper = step(UV, 1.0);\nreturn lower.x * lower.y * upper.x * upper.y;"
      OutputType=CMOT_Float1
      Description="V5 reject history outside previous local field"
      Inputs(0)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionCustom'V5_M_FoamStateUpdate:MaterialExpressionCustom_9'"))
      MaterialExpressionEditorX=180
      MaterialExpressionEditorY=220
      MaterialExpressionGuid=EC2A3B8E461FA057566C4EBAD2A58D05
      Material="/Script/Engine.Material'V5_M_FoamStateUpdate'"
      Desc="V5 reject history outside previous local field"
   End Object
   Begin Object Name="MaterialExpressionCustom_11" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Tests/Realistic_Water/V5_PersistentAdvectedFoam/V5_M_FoamStateUpdate.V5_M_FoamStateUpdate:MaterialExpressionCustom_11'"
      Code="float dt = max(DeltaSeconds, 1.0e-4);\nfloat advected = saturate(PreviousDensity) * Inside;\nfloat decayed = advected * exp(-dt / max(Lifetime, 0.1));\n// Fix for Float16 quantization stall at high framerates\ndecayed = max(0.0, decayed - 0.01 * dt);\nfloat density = 1.0 - (1.0 - decayed) * exp(-saturate(Source) * SourceRate * dt);\nreturn saturate(float3(density, density, density));"
      Description="V5 persistent foam: CPU source, exact velocity advection, exponential lifetime"
      Inputs(0)=(InputName="PreviousDensity",Input=(Expression="/Script/Engine.MaterialExpressionComponentMask'V5_M_FoamStateUpdate:MaterialExpressionComponentMask_8'"))
      Inputs(1)=(InputName="Source",Input=(Expression="/Script/Engine.MaterialExpressionComponentMask'V5_M_FoamStateUpdate:MaterialExpressionComponentMask_6'"))
      Inputs(2)=(InputName="Inside",Input=(Expression="/Script/Engine.MaterialExpressionCustom'V5_M_FoamStateUpdate:MaterialExpressionCustom_10'"))
      Inputs(3)=(InputName="DeltaSeconds",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'V5_M_FoamStateUpdate:MaterialExpressionScalarParameter_13'"))
      Inputs(4)=(InputName="Lifetime",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'V5_M_FoamStateUpdate:MaterialExpressionScalarParameter_16'"))
      Inputs(5)=(InputName="SourceRate",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'V5_M_FoamStateUpdate:MaterialExpressionScalarParameter_17'"))
      MaterialExpressionEditorX=760
      MaterialExpressionEditorY=60
      MaterialExpressionGuid=4E6391944945299A956F638082E6C7AD
      Material="/Script/Engine.Material'V5_M_FoamStateUpdate'"
      Desc="V5 persistent foam: CPU source, exact velocity advection, exponential lifetime"
   End Object
   Begin Object Name="MaterialExpressionCustom_7" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Tests/Realistic_Water/V5_PersistentAdvectedFoam/V5_M_FoamStateUpdate.V5_M_FoamStateUpdate:MaterialExpressionCustom_7'"
      Code="return Center + (UV - 0.5) * FieldSize;"
      OutputType=CMOT_Float2
      Description="V5 reconstruct world XY for local foam domain"
      Inputs(0)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'V5_M_FoamStateUpdate:MaterialExpressionTextureCoordinate_1'"))
      Inputs(1)=(InputName="Center",Input=(Expression="/Script/Engine.MaterialExpressionComponentMask'V5_M_FoamStateUpdate:MaterialExpressionComponentMask_3'"))
      Inputs(2)=(InputName="FieldSize",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'V5_M_FoamStateUpdate:MaterialExpressionScalarParameter_12'"))
      MaterialExpressionEditorX=-1280
      MaterialExpressionEditorY=-260
      MaterialExpressionGuid=82B4158647E38E27C4F34EBFF2D63CC1
      Material="/Script/Engine.Material'V5_M_FoamStateUpdate'"
      Desc="V5 reconstruct world XY for local foam domain"
   End Object
   Begin Object Name="MaterialExpressionCustom_8" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Tests/Realistic_Water/V5_PersistentAdvectedFoam/V5_M_FoamStateUpdate.V5_M_FoamStateUpdate:MaterialExpressionCustom_8'"
      Code="return (WorldXY - SourceCenter) / max(FieldSize, 1.0) + 0.5;"
      OutputType=CMOT_Float2
      Description="V5 map current world position into CPU Gerstner source field"
      Inputs(0)=(InputName="WorldXY",Input=(Expression="/Script/Engine.MaterialExpressionCustom'V5_M_FoamStateUpdate:MaterialExpressionCustom_7'"))
      Inputs(1)=(InputName="SourceCenter",Input=(Expression="/Script/Engine.MaterialExpressionComponentMask'V5_M_FoamStateUpdate:MaterialExpressionComponentMask_5'"))
      Inputs(2)=(InputName="FieldSize",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'V5_M_FoamStateUpdate:MaterialExpressionScalarParameter_12'"))
      MaterialExpressionEditorX=-1000
      MaterialExpressionEditorY=-160
      MaterialExpressionGuid=44BEF5EC43C45D4A74D05FA4736FC341
      Material="/Script/Engine.Material'V5_M_FoamStateUpdate'"
      Desc="V5 map current world position into CPU Gerstner source field"
   End Object
   Begin Object Name="MaterialExpressionCustom_9" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Tests/Realistic_Water/V5_PersistentAdvectedFoam/V5_M_FoamStateUpdate.V5_M_FoamStateUpdate:MaterialExpressionCustom_9'"
      Code="float2 velocityCmPerSecond = (EncodedVelocity * 2.0 - 1.0) * MaxVelocity;\nfloat2 backtracedWorldXY = WorldXY - velocityCmPerSecond * DeltaSeconds * Scale;\nreturn (backtracedWorldXY - PreviousCenter) / max(FieldSize, 1.0) + 0.5;"
      OutputType=CMOT_Float2
      Description="V5 semi-Lagrangian backtrace using CPU exact Gerstner velocity"
      Inputs(0)=(InputName="WorldXY",Input=(Expression="/Script/Engine.MaterialExpressionCustom'V5_M_FoamStateUpdate:MaterialExpressionCustom_7'"))
      Inputs(1)=(InputName="PreviousCenter",Input=(Expression="/Script/Engine.MaterialExpressionComponentMask'V5_M_FoamStateUpdate:MaterialExpressionComponentMask_4'"))
      Inputs(2)=(InputName="FieldSize",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'V5_M_FoamStateUpdate:MaterialExpressionScalarParameter_12'"))
      Inputs(3)=(InputName="EncodedVelocity",Input=(Expression="/Script/Engine.MaterialExpressionComponentMask'V5_M_FoamStateUpdate:MaterialExpressionComponentMask_7'"))
      Inputs(4)=(InputName="MaxVelocity",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'V5_M_FoamStateUpdate:MaterialExpressionScalarParameter_14'"))
      Inputs(5)=(InputName="DeltaSeconds",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'V5_M_FoamStateUpdate:MaterialExpressionScalarParameter_13'"))
      Inputs(6)=(InputName="Scale",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'V5_M_FoamStateUpdate:MaterialExpressionScalarParameter_15'"))
      MaterialExpressionEditorX=-120
      MaterialExpressionEditorY=40
      MaterialExpressionGuid=F968AA334D2260F2E00ACD907DB429FB
      Material="/Script/Engine.Material'V5_M_FoamStateUpdate'"
      Desc="V5 semi-Lagrangian backtrace using CPU exact Gerstner velocity"
   End Object

#ifndef SW_GERSTNER_CREST_OPTICS_USH
#define SW_GERSTNER_CREST_OPTICS_USH

// Compute the normalized optical path at a Gerstner crest. This value is
// shared by scattering and absorption so the expensive crest mask is only
// evaluated once in the material graph.
float SW_ComputeGerstnerCrestOpticalPath(
    float3 GerstnerWPO,
    float3 GerstnerNormal,
    float4 CrestBounds,
    float ShoulderInfluence,
    float MinOpticalPathScale,
    float Enabled)
{
    if (Enabled <= 0.5)
    {
        return 1.0;
    }

    const float HeightStart = min(CrestBounds.x, CrestBounds.y - 1.0e-4);
    const float HeightFull = max(CrestBounds.y, CrestBounds.x + 1.0e-4);
    const float SlopeStart = min(CrestBounds.z, CrestBounds.w - 1.0e-5);
    const float SlopeFull = max(CrestBounds.w, CrestBounds.z + 1.0e-5);

    // Height is the primary crest selector. A Gerstner crest can be locally
    // flat, so slope may shape the upper shoulder but must never be mandatory.
    const float HeightMask = smoothstep(HeightStart, HeightFull, GerstnerWPO.z);
    const float Slope = 1.0 - saturate(normalize(GerstnerNormal).z);
    const float ShoulderMask = smoothstep(SlopeStart, SlopeFull, Slope);
    const float CrestMask = saturate(
        HeightMask * lerp(1.0, ShoulderMask, saturate(ShoulderInfluence)));

    const float SafeMinPathScale = clamp(MinOpticalPathScale, 0.05, 1.0);
    return lerp(1.0, SafeMinPathScale, CrestMask);
}

// Apply the short-path scale to scattering and add only a restrained
// subsurface tint. Absorption must be multiplied by the same path scale in
// the material graph.
float3 SW_ApplyGerstnerCrestScattering(
    float3 BaseScattering,
    float OpticalPathScale,
    float MinOpticalPathScale,
    float3 SubsurfaceTint,
    float SubsurfaceTintStrength)
{
    const float SafeMinPathScale = clamp(MinOpticalPathScale, 0.05, 1.0);
    const float PathRange = max(1.0 - SafeMinPathScale, 1.0e-4);
    const float CrestMask = saturate((1.0 - OpticalPathScale) / PathRange);

    // The optical path reduction is the primary effect. The tint only nudges
    // the scattering albedo; it must not become a painted emerald overlay.
    const float3 SafeTint = max(SubsurfaceTint, float3(0.0, 0.0, 0.0));
    const float TintWeight = CrestMask * saturate(SubsurfaceTintStrength);
    const float3 TintMultiplier = lerp(float3(1.0, 1.0, 1.0), SafeTint, TintWeight);
    return BaseScattering * OpticalPathScale * TintMultiplier;
}

#endif

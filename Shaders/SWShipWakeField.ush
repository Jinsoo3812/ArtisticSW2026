// M3 signed-height field update and sampling macros.
// Kept macro-only because Unreal Material Custom includes are expanded inside
// the generated CustomExpression function.
#pragma once

#define SW_WAKE_FIELD_CAPACITY 64

#define SW_SAMPLE_SHIP_WAKE_FIELD(WORLD_XY, FIELD_TEXTURE, FIELD_SAMPLER, FIELD_CENTER, FIELD_SIZE, OUT_HEIGHT) \
{ \
    const float SW_FieldSizeSafe = max(FIELD_SIZE, 1.0); \
    const float2 SW_FieldUV = ((WORLD_XY) - (FIELD_CENTER)) / SW_FieldSizeSafe + 0.5; \
    const float SW_FieldInside = step(0.0, SW_FieldUV.x) * step(SW_FieldUV.x, 1.0) \
        * step(0.0, SW_FieldUV.y) * step(SW_FieldUV.y, 1.0); \
    OUT_HEIGHT = Texture2DSampleLevel(FIELD_TEXTURE, FIELD_SAMPLER, saturate(SW_FieldUV), 0.0).r * SW_FieldInside; \
}

#define SW_UPDATE_SHIP_WAKE_FIELD(OUTPUT_UV, PREVIOUS_TEXTURE, PREVIOUS_SAMPLER, CURRENT_TEXTURE, CURRENT_SAMPLER, WAKE_TEXTURE, WAKE_SAMPLER, SERVER_TIME, EVENT_COUNT, PREVIOUS_CENTER, CURRENT_CENTER, OUTPUT_CENTER, FIELD_SIZE, FIELD_RESOLUTION, DELTA_TIME, WAVE_SPEED, DAMPING, SOURCE_RATE, OUT_HEIGHT) \
{ \
    const float2 SW_OutputUV = OUTPUT_UV; \
    const float SW_FieldSize = max(FIELD_SIZE, 1.0); \
    const float SW_Resolution = max(FIELD_RESOLUTION, 4.0); \
    const float SW_DeltaTime = max(DELTA_TIME, 1.0 / 240.0); \
    const float2 SW_WorldPosition = (OUTPUT_CENTER) + (SW_OutputUV - 0.5) * SW_FieldSize; \
    const float2 SW_PreviousUV = (SW_WorldPosition - (PREVIOUS_CENTER)) / SW_FieldSize + 0.5; \
    const float2 SW_CurrentUV = (SW_WorldPosition - (CURRENT_CENTER)) / SW_FieldSize + 0.5; \
    const float2 SW_Texel = float2(1.0 / SW_Resolution, 1.0 / SW_Resolution); \
    const float SW_PreviousInside = step(0.0, SW_PreviousUV.x) * step(SW_PreviousUV.x, 1.0) \
        * step(0.0, SW_PreviousUV.y) * step(SW_PreviousUV.y, 1.0); \
    const float SW_CurrentInside = step(SW_Texel.x, SW_CurrentUV.x) * step(SW_CurrentUV.x, 1.0 - SW_Texel.x) \
        * step(SW_Texel.y, SW_CurrentUV.y) * step(SW_CurrentUV.y, 1.0 - SW_Texel.y); \
    const float SW_PreviousHeight = Texture2DSampleLevel(PREVIOUS_TEXTURE, PREVIOUS_SAMPLER, saturate(SW_PreviousUV), 0.0).r * SW_PreviousInside; \
    const float SW_CurrentHeight = Texture2DSampleLevel(CURRENT_TEXTURE, CURRENT_SAMPLER, saturate(SW_CurrentUV), 0.0).r * SW_CurrentInside; \
    const float SW_Left = Texture2DSampleLevel(CURRENT_TEXTURE, CURRENT_SAMPLER, saturate(SW_CurrentUV - float2(SW_Texel.x, 0.0)), 0.0).r * SW_CurrentInside; \
    const float SW_RightHeight = Texture2DSampleLevel(CURRENT_TEXTURE, CURRENT_SAMPLER, saturate(SW_CurrentUV + float2(SW_Texel.x, 0.0)), 0.0).r * SW_CurrentInside; \
    const float SW_Down = Texture2DSampleLevel(CURRENT_TEXTURE, CURRENT_SAMPLER, saturate(SW_CurrentUV - float2(0.0, SW_Texel.y)), 0.0).r * SW_CurrentInside; \
    const float SW_Up = Texture2DSampleLevel(CURRENT_TEXTURE, CURRENT_SAMPLER, saturate(SW_CurrentUV + float2(0.0, SW_Texel.y)), 0.0).r * SW_CurrentInside; \
    const float SW_Laplacian = SW_Left + SW_RightHeight + SW_Down + SW_Up - 4.0 * SW_CurrentHeight; \
    const float SW_TexelWorldSize = SW_FieldSize / SW_Resolution; \
    const float SW_Courant = min(max(WAVE_SPEED, 0.0) * SW_DeltaTime / max(SW_TexelWorldSize, 1.0), 0.68); \
    const float SW_VelocityDamping = exp(-max(DAMPING, 0.0) * SW_DeltaTime); \
    float SW_NextHeight = SW_CurrentHeight \
        + (SW_CurrentHeight - SW_PreviousHeight) * SW_VelocityDamping \
        + SW_Courant * SW_Courant * SW_Laplacian; \
    float SW_SourceHeight = 0.0; \
    const int SW_Count = clamp((int)round(EVENT_COUNT), 0, SW_WAKE_FIELD_CAPACITY); \
    [loop] \
    for (int SW_EventIndex = 0; SW_EventIndex < SW_WAKE_FIELD_CAPACITY; ++SW_EventIndex) \
    { \
        if (SW_EventIndex >= SW_Count) \
        { \
            break; \
        } \
        const float SW_EventU = (float(SW_EventIndex) + 0.5) / float(SW_WAKE_FIELD_CAPACITY); \
        const float4 SW_Row0 = Texture2DSampleLevel(WAKE_TEXTURE, WAKE_SAMPLER, float2(SW_EventU, 1.0 / 10.0), 0.0); \
        const float4 SW_Row1 = Texture2DSampleLevel(WAKE_TEXTURE, WAKE_SAMPLER, float2(SW_EventU, 3.0 / 10.0), 0.0); \
        const float4 SW_Row2 = Texture2DSampleLevel(WAKE_TEXTURE, WAKE_SAMPLER, float2(SW_EventU, 5.0 / 10.0), 0.0); \
        const float4 SW_Row4 = Texture2DSampleLevel(WAKE_TEXTURE, WAKE_SAMPLER, float2(SW_EventU, 9.0 / 10.0), 0.0); \
        const float SW_Age = (SERVER_TIME) - SW_Row0.z; \
        const float SW_Lifetime = max(SW_Row2.w, 0.1); \
        if (SW_Row0.w > 0.0 && SW_Age >= 0.0 && SW_Age < SW_Lifetime) \
        { \
            const float2 SW_Forward = normalize(SW_Row1.xy + float2(1.0e-8, 0.0)); \
            const float2 SW_RightVector = float2(-SW_Forward.y, SW_Forward.x); \
            const float SW_HullLength = max(SW_Row1.w, 100.0); \
            const float SW_Beam = max(SW_Row2.x, 50.0); \
            const float SW_PredictionTime = clamp(SW_Age, 0.0, 0.20); \
            const float2 SW_Stern = SW_Row0.xy + SW_Forward * max(SW_Row4.x, 0.0) * SW_PredictionTime; \
            const float2 SW_Bow = SW_Stern + SW_Forward * SW_HullLength; \
            [unroll] \
            for (int SW_SourceIndex = 0; SW_SourceIndex < 3; ++SW_SourceIndex) \
            { \
                const float SW_IsBow = 1.0 - step(0.5, float(SW_SourceIndex)); \
                const float SW_Side = float(SW_SourceIndex) * 2.0 - 3.0; \
                const float2 SW_Shoulder = SW_Stern + SW_RightVector * SW_Side * SW_Beam * 0.32; \
                const float2 SW_SourcePosition = lerp(SW_Shoulder, SW_Bow, SW_IsBow); \
                const float2 SW_SourceDelta = SW_WorldPosition - SW_SourcePosition; \
                const float SW_AlongScale = lerp(SW_Beam * 0.42, max(SW_HullLength * 0.12, SW_Beam * 0.55), SW_IsBow); \
                const float SW_AcrossScale = lerp(SW_Beam * 0.30, SW_Beam * 0.34, SW_IsBow); \
                const float SW_Along = dot(SW_SourceDelta, SW_Forward) / max(SW_AlongScale, 1.0); \
                const float SW_Across = dot(SW_SourceDelta, SW_RightVector) / max(SW_AcrossScale, 1.0); \
                const float SW_RadiusSquared = SW_Along * SW_Along + SW_Across * SW_Across; \
                const float SW_Ricker = (1.0 - SW_RadiusSquared) * exp(-SW_RadiusSquared); \
                const float SW_SourceWeight = lerp(0.42, 1.0, SW_IsBow); \
                SW_SourceHeight += SW_Row0.w * SW_SourceWeight * SW_Ricker; \
            } \
        } \
    } \
    SW_NextHeight += SW_SourceHeight * max(SOURCE_RATE, 0.0) * SW_DeltaTime; \
    const float SW_EdgeDistance = min(min(SW_OutputUV.x, 1.0 - SW_OutputUV.x), min(SW_OutputUV.y, 1.0 - SW_OutputUV.y)); \
    const float SW_BoundaryAbsorption = smoothstep(0.0, 12.0 / SW_Resolution, SW_EdgeDistance); \
    OUT_HEIGHT = clamp(SW_NextHeight * SW_BoundaryAbsorption, -200.0, 200.0); \
}

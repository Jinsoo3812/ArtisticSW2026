#pragma once

// 3-Way Animated Flux Deep Ocean Foam Evaluator
// Used by MF_FluxDeepOceanFoam Custom Nodes

#define SW_CALCULATE_FLUX_DEEP_OCEAN_FOAM(WORLD_UV_IN, TIME_IN, FOAM_HEIGHT_TEX, FOAM_HEIGHT_SAMPLER, FOAM_ORM_TEX, FOAM_ORM_SAMPLER, OUT_FOAM) \
{ \
    const float2 SW_WorldUV = (WORLD_UV_IN) / 1500.0; \
    const float3 SW_OutOffset = (TIME_IN) * 0.15 + float3(0.0, 1.0, 2.0) / 3.0; \
    const float3 SW_FracTime = frac(SW_OutOffset); \
    const float3 SW_Weight = (cos(2.0 * 3.14159265 * SW_FracTime) * 0.5 + 0.5) * (2.0 / 3.0); \
    const float2 SW_UV1 = SW_WorldUV + SW_OutOffset.x * 0.5; \
    const float2 SW_UV2 = SW_WorldUV + SW_OutOffset.y * 0.5; \
    const float2 SW_UV3 = SW_WorldUV + SW_OutOffset.z * 0.5; \
    const float SW_Foam1 = Texture2DSample(FOAM_HEIGHT_TEX, FOAM_HEIGHT_SAMPLER, SW_UV1).r; \
    const float SW_Foam2 = Texture2DSample(FOAM_HEIGHT_TEX, FOAM_HEIGHT_SAMPLER, SW_UV2).r; \
    const float SW_Foam3 = Texture2DSample(FOAM_HEIGHT_TEX, FOAM_HEIGHT_SAMPLER, SW_UV3).r; \
    const float SW_FoamBase = SW_Foam1 * SW_Weight.x + SW_Foam2 * SW_Weight.y + SW_Foam3 * SW_Weight.z; \
    const float SW_AO1 = Texture2DSample(FOAM_ORM_TEX, FOAM_ORM_SAMPLER, SW_UV1).r; \
    const float SW_AO2 = Texture2DSample(FOAM_ORM_TEX, FOAM_ORM_SAMPLER, SW_UV2).r; \
    const float SW_AO3 = Texture2DSample(FOAM_ORM_TEX, FOAM_ORM_SAMPLER, SW_UV3).r; \
    const float SW_FoamAO = SW_AO1 * SW_Weight.x + SW_AO2 * SW_Weight.y + SW_AO3 * SW_Weight.z; \
    const float SW_Shadow = pow(saturate(SW_FoamAO), 1.2); \
    OUT_FOAM = saturate(SW_FoamBase * SW_Shadow); \
}

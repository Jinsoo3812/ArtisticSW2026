#pragma once

// Ripple Subsystem Evaluator for WPO and Normal Computation
// Macro-only design for Unreal Engine Material Custom Nodes

#define SW_RIPPLE_CAPACITY 32

#define SW_EVALUATE_RIPPLE_HEIGHT(WORLD_XY, SERVER_TIME, RIPPLE_TEX, OUT_HEIGHT) \
{ \
    const float2 SW_R_WorldPos = (WORLD_XY); \
    const float SW_R_ServerTime = (SERVER_TIME); \
    float SW_R_TotalHeight = 0.0; \
    [loop] \
    for (int SW_R_Index = 0; SW_R_Index < SW_RIPPLE_CAPACITY; ++SW_R_Index) \
    { \
        const float4 SW_R_Row1 = (RIPPLE_TEX).Load(int3(SW_R_Index, 0, 0)); \
        const float4 SW_R_Row2 = (RIPPLE_TEX).Load(int3(SW_R_Index, 1, 0)); \
        const float2 SW_R_Origin = SW_R_Row1.xy; \
        const float SW_R_StartTime = SW_R_Row1.z; \
        const float SW_R_InitialAmp = SW_R_Row1.w; \
        const float SW_R_WaveSpeed = SW_R_Row2.x; \
        const float SW_R_DecayRate = SW_R_Row2.y; \
        const float SW_R_WaveLength = SW_R_Row2.z; \
        const float SW_R_ExpireTime = SW_R_Row2.w; \
        if (SW_R_InitialAmp <= 0.0 || SW_R_ServerTime >= SW_R_ExpireTime) continue; \
        const float SW_R_dt = SW_R_ServerTime - SW_R_StartTime; \
        if (SW_R_dt < 0.0) continue; \
        const float SW_R_d = distance(SW_R_WorldPos, SW_R_Origin); \
        const float SW_R_R = SW_R_WaveSpeed * SW_R_dt; \
        const float SW_R_W = SW_R_WaveLength * 2.0; \
        if (SW_R_d > SW_R_R + SW_R_W || (SW_R_R > SW_R_W && SW_R_d < SW_R_R - SW_R_W)) continue; \
        const float SW_R_Decay = exp(-SW_R_DecayRate * SW_R_dt); \
        const float SW_R_DistFromFront = abs(SW_R_d - SW_R_R); \
        const float SW_R_Envelope = 1.0 - smoothstep(0.0, SW_R_W, SW_R_DistFromFront); \
        const float SW_R_Phase = (SW_R_d - SW_R_R) / SW_R_WaveLength * 2.0 * 3.14159265; \
        SW_R_TotalHeight += SW_R_InitialAmp * SW_R_Decay * cos(SW_R_Phase) * SW_R_Envelope; \
    } \
    OUT_HEIGHT = SW_R_TotalHeight; \
}

#define SW_EVALUATE_RIPPLE_NORMAL(WORLD_XY, SERVER_TIME, RIPPLE_TEX, NORMAL_STRENGTH, OUT_NORMAL) \
{ \
    float SW_R_H_Center = 0.0; \
    SW_EVALUATE_RIPPLE_HEIGHT(WORLD_XY, SERVER_TIME, RIPPLE_TEX, SW_R_H_Center); \
    const float2 SW_R_Pos2D = (WORLD_XY); \
    const float2 SW_R_dX = ddx(SW_R_Pos2D); \
    const float2 SW_R_dY = ddy(SW_R_Pos2D); \
    const float SW_R_dH_dX = ddx(SW_R_H_Center); \
    const float SW_R_dH_dY = ddy(SW_R_H_Center); \
    const float SW_R_Det = SW_R_dX.x * SW_R_dY.y - SW_R_dX.y * SW_R_dY.x; \
    float SW_R_dHdX = 0.0; \
    float SW_R_dHdY = 0.0; \
    if (abs(SW_R_Det) > 1.0e-7) \
    { \
        const float SW_R_InvDet = 1.0 / SW_R_Det; \
        SW_R_dHdX = (SW_R_dH_dX * SW_R_dY.y - SW_R_dH_dY * SW_R_dX.y) * SW_R_InvDet; \
        SW_R_dHdY = (SW_R_dH_dY * SW_R_dX.x - SW_R_dH_dX * SW_R_dY.x) * SW_R_InvDet; \
    } \
    OUT_NORMAL = normalize(float3(-SW_R_dHdX * (NORMAL_STRENGTH), -SW_R_dHdY * (NORMAL_STRENGTH), 1.0)); \
}

// Compute-shader form: evaluates height and the analytic world-space gradient in one event scan.
// Screen-space ddx/ddy are unavailable in a compute shader, so this differentiates the ripple
// equation with respect to radial distance instead.
#define SW_EVALUATE_RIPPLE_COMBINED_ANALYTIC(WORLD_XY, SERVER_TIME, RIPPLE_COUNT, RIPPLE_TEX, NORMAL_STRENGTH, OUT_HEIGHT, OUT_NORMAL) \
{ \
    const float2 SW_R_WorldPos = (WORLD_XY); \
    const float SW_R_ServerTime = (SERVER_TIME); \
    const int SW_R_Count = clamp((int)round(RIPPLE_COUNT), 0, SW_RIPPLE_CAPACITY); \
    float SW_R_TotalHeight = 0.0; \
    float2 SW_R_TotalGradient = float2(0.0, 0.0); \
    [loop] \
    for (int SW_R_Index = 0; SW_R_Index < SW_RIPPLE_CAPACITY; ++SW_R_Index) \
    { \
        if (SW_R_Index >= SW_R_Count) break; \
        const float4 SW_R_Row1 = (RIPPLE_TEX).Load(int3(SW_R_Index, 0, 0)); \
        const float4 SW_R_Row2 = (RIPPLE_TEX).Load(int3(SW_R_Index, 1, 0)); \
        const float2 SW_R_Origin = SW_R_Row1.xy; \
        const float SW_R_StartTime = SW_R_Row1.z; \
        const float SW_R_InitialAmp = SW_R_Row1.w; \
        const float SW_R_WaveSpeed = SW_R_Row2.x; \
        const float SW_R_DecayRate = SW_R_Row2.y; \
        const float SW_R_WaveLength = SW_R_Row2.z; \
        const float SW_R_ExpireTime = SW_R_Row2.w; \
        if (SW_R_InitialAmp <= 0.0 || SW_R_ServerTime >= SW_R_ExpireTime || SW_R_ServerTime < SW_R_StartTime || SW_R_WaveLength <= 1.0e-6) continue; \
        const float SW_R_dt = SW_R_ServerTime - SW_R_StartTime; \
        const float2 SW_R_Delta = SW_R_WorldPos - SW_R_Origin; \
        const float SW_R_DistSq = dot(SW_R_Delta, SW_R_Delta); \
        const float SW_R_d = sqrt(max(SW_R_DistSq, 1.0e-12)); \
        const float SW_R_R = SW_R_WaveSpeed * SW_R_dt; \
        const float SW_R_W = SW_R_WaveLength * 2.0; \
        const float SW_R_SignedFrontDistance = SW_R_d - SW_R_R; \
        const float SW_R_DistFromFront = abs(SW_R_SignedFrontDistance); \
        if (SW_R_DistFromFront > SW_R_W) continue; \
        const float SW_R_t = saturate(SW_R_DistFromFront / SW_R_W); \
        const float SW_R_Envelope = 1.0 - SW_R_t * SW_R_t * (3.0 - 2.0 * SW_R_t); \
        const float SW_R_Decay = exp(-SW_R_DecayRate * SW_R_dt); \
        const float SW_R_Phase = SW_R_SignedFrontDistance / SW_R_WaveLength * 6.28318530718; \
        const float SW_R_CosPhase = cos(SW_R_Phase); \
        const float SW_R_SinPhase = sin(SW_R_Phase); \
        const float SW_R_Amplitude = SW_R_InitialAmp * SW_R_Decay; \
        SW_R_TotalHeight += SW_R_Amplitude * SW_R_CosPhase * SW_R_Envelope; \
        const float SW_R_EnvelopeDerivativeMagnitude = 6.0 * SW_R_t * (1.0 - SW_R_t) / SW_R_W; \
        const float SW_R_EnvelopeDerivative = -SW_R_EnvelopeDerivativeMagnitude * sign(SW_R_SignedFrontDistance); \
        const float SW_R_PhaseDerivative = 6.28318530718 / SW_R_WaveLength; \
        const float SW_R_dHdr = SW_R_Amplitude * (-SW_R_SinPhase * SW_R_PhaseDerivative * SW_R_Envelope + SW_R_CosPhase * SW_R_EnvelopeDerivative); \
        SW_R_TotalGradient += SW_R_dHdr * (SW_R_Delta / SW_R_d); \
    } \
    OUT_HEIGHT = SW_R_TotalHeight; \
    OUT_NORMAL = normalize(float3(-SW_R_TotalGradient.x * (NORMAL_STRENGTH), -SW_R_TotalGradient.y * (NORMAL_STRENGTH), 1.0)); \
}

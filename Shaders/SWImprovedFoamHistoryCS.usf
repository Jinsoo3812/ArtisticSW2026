#include "/Engine/Public/Platform.ush"

Texture2D<float4> PreviousHistory;
SamplerState PreviousHistorySampler;

Texture2D<float> KelvinSource;
SamplerState KelvinSourceSampler;

Texture2D<float> RippleSource;
SamplerState RippleSourceSampler;

RWTexture2D<float4> OutHistory;

float2 PreviousCenter;
float2 CurrentCenter;
float FieldSize;
float2 KelvinCenter;
float KelvinSize;
float KelvinEnabled;
float2 RippleCenter;
float RippleSize;
float RippleEnabled;
float DeltaSeconds;
float KelvinLifetime;
float RippleLifetime;
float KelvinGenerationRate;
float RippleGenerationRate;
float KelvinDiffusion;
float RippleDiffusion;

float SW_SampleSource(Texture2D<float> Source, SamplerState SourceSampler, float2 WorldXY, float2 Center, float Size, float Enabled)
{
    if (Enabled < 0.5 || Size <= 1.0)
    {
        return 0.0;
    }
    const float2 UV = (WorldXY - Center) / Size + 0.5;
    const float Inside = step(0.0, UV.x) * step(UV.x, 1.0) * step(0.0, UV.y) * step(UV.y, 1.0);
    return Source.SampleLevel(SourceSampler, saturate(UV), 0.0).r * Inside;
}

[numthreads(16, 16, 1)]
void MainCS(uint3 DTid : SV_DispatchThreadID)
{
    uint Width, Height;
    OutHistory.GetDimensions(Width, Height);
    if (DTid.x >= Width || DTid.y >= Height)
    {
        return;
    }

    const float2 Dimensions = float2(Width, Height);
    const float2 UV = (float2(DTid.xy) + 0.5) / Dimensions;
    const float2 WorldXY = CurrentCenter + (UV - 0.5) * FieldSize;
    const float2 PreviousUV = (WorldXY - PreviousCenter) / max(FieldSize, 1.0) + 0.5;
    const float PreviousInside = step(0.0, PreviousUV.x) * step(PreviousUV.x, 1.0)
        * step(0.0, PreviousUV.y) * step(PreviousUV.y, 1.0);

    float2 History = PreviousHistory.SampleLevel(PreviousHistorySampler, saturate(PreviousUV), 0.0).rg
        * PreviousInside;

    if (PreviousInside > 0.5 && (KelvinDiffusion > 0.0 || RippleDiffusion > 0.0))
    {
        const float2 Texel = 1.0 / Dimensions;
        const float2 NeighborAverage = (
            PreviousHistory.SampleLevel(PreviousHistorySampler, saturate(PreviousUV + float2(Texel.x, 0.0)), 0.0).rg
            + PreviousHistory.SampleLevel(PreviousHistorySampler, saturate(PreviousUV - float2(Texel.x, 0.0)), 0.0).rg
            + PreviousHistory.SampleLevel(PreviousHistorySampler, saturate(PreviousUV + float2(0.0, Texel.y)), 0.0).rg
            + PreviousHistory.SampleLevel(PreviousHistorySampler, saturate(PreviousUV - float2(0.0, Texel.y)), 0.0).rg) * 0.25;
        History.r = lerp(History.r, NeighborAverage.r, saturate(KelvinDiffusion * DeltaSeconds));
        History.g = lerp(History.g, NeighborAverage.g, saturate(RippleDiffusion * DeltaSeconds));
    }

    History.r *= exp(-DeltaSeconds / max(KelvinLifetime, 0.01));
    History.g *= exp(-DeltaSeconds / max(RippleLifetime, 0.01));

    const float KelvinEmission = SW_SampleSource(
        KelvinSource, KelvinSourceSampler, WorldXY, KelvinCenter, KelvinSize, KelvinEnabled);
    const float RippleEmission = SW_SampleSource(
        RippleSource, RippleSourceSampler, WorldXY, RippleCenter, RippleSize, RippleEnabled);

    History.r = saturate(History.r + KelvinEmission * KelvinGenerationRate * DeltaSeconds);
    History.g = saturate(History.g + RippleEmission * RippleGenerationRate * DeltaSeconds);
    const float Combined = 1.0 - (1.0 - History.r) * (1.0 - History.g);
    OutHistory[DTid.xy] = float4(History, Combined, 1.0);
}

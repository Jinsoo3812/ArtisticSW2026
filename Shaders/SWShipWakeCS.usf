#include "/Engine/Public/Platform.ush"
#include "/Project/Shaders/SWShipWake.ush"

Texture2D EventTexture;
SamplerState EventTextureSampler;

Texture2D GoldenTexture;
SamplerState GoldenTextureSampler;

RWTexture2D<float4> OutWakeTexture;
RWTexture2D<float> OutKelvinFoamTexture;

float2 GridCenter;
float GridSize;
float ServerTime;
float EventCount;
float NormalStrength;
float FoamSteepnessMin;
float FoamSteepnessMax;
float FoamEnabled;
float FoamIntensity;

[numthreads(16, 16, 1)]
void MainCS(uint3 DTid : SV_DispatchThreadID)
{
    uint2 TexCoord = DTid.xy;
    uint Width, Height;
    OutWakeTexture.GetDimensions(Width, Height);
    if (TexCoord.x >= Width || TexCoord.y >= Height)
    {
        return;
    }

    // Convert TexCoord (0~Resolution) to UV (0~1) -> World Position (XY)
    float2 UV = (float2(TexCoord) + 0.5) / float2(Width, Height);
    float2 WorldXY = GridCenter + (UV - 0.5) * GridSize;

    float OutHeight = 0.0;
    float3 OutNormal = float3(0.0, 0.0, 1.0);
    float OutFoam = 0.0;

    SW_M7_EVALUATE_KELVIN_COMBINED(
        WorldXY,
        ServerTime,
        EventCount,
        EventTexture,
        EventTextureSampler,
        GoldenTexture,
        GoldenTextureSampler,
        NormalStrength,
        FoamSteepnessMin,
        FoamSteepnessMax,
        FoamEnabled,
        FoamIntensity,
        OutHeight,
        OutNormal,
        OutFoam
    );

    // Write: R = Height, G = Normal.X, B = Normal.Y, A = Normal.Z
    OutWakeTexture[TexCoord] = float4(OutHeight, OutNormal.x, OutNormal.y, OutNormal.z);
    if (FoamEnabled > 0.5)
    {
        OutKelvinFoamTexture[TexCoord] = OutFoam;
    }
}

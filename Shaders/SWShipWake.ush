// Ship wake evaluator for Unreal Material Custom expressions.
//
// Include File Paths are expanded inside Unreal's generated CustomExpression
// function. Global HLSL function declarations are therefore invalid here.
// Keep this file macro-only so the evaluator can be shared by WPO and foam
// Custom nodes without producing nested function definitions.
#pragma once

#define SW_SHIP_WAKE_CAPACITY 64
#define SW_SHIP_WAKE_PI 3.14159265358979323846

#define SW_EVALUATE_SHIP_WAKE(QUERY_POSITION, SERVER_TIME, EVENT_COUNT, WAKE_TEXTURE, WAKE_SAMPLER, OUT_HEIGHT, OUT_FOAM) \
{ \
    OUT_HEIGHT = 0.0; \
    OUT_FOAM = 0.0; \
    const float2 SW_QueryPosition = QUERY_POSITION; \
    const float SW_ServerTime = SERVER_TIME; \
    const int SW_Count = clamp((int)round(EVENT_COUNT), 0, SW_SHIP_WAKE_CAPACITY); \
    [loop] \
    for (int SW_Index = 0; SW_Index < SW_SHIP_WAKE_CAPACITY; ++SW_Index) \
    { \
        if (SW_Index >= SW_Count) \
        { \
            break; \
        } \
        const float SW_U = (float(SW_Index) + 0.5) / float(SW_SHIP_WAKE_CAPACITY); \
        const float4 SW_Row0 = Texture2DSampleLevel(WAKE_TEXTURE, WAKE_SAMPLER, float2(SW_U, 1.0 / 6.0), 0.0); \
        const float4 SW_Row1 = Texture2DSampleLevel(WAKE_TEXTURE, WAKE_SAMPLER, float2(SW_U, 3.0 / 6.0), 0.0); \
        const float4 SW_Row2 = Texture2DSampleLevel(WAKE_TEXTURE, WAKE_SAMPLER, float2(SW_U, 5.0 / 6.0), 0.0); \
        const float2 SW_Origin = SW_Row0.xy; \
        const float SW_StartTime = SW_Row0.z; \
        const float SW_Amplitude = SW_Row0.w; \
        const float2 SW_Forward = normalize(SW_Row1.xy + float2(1.0e-8, 0.0)); \
        const float SW_WaveLength = max(SW_Row1.z, 1.0); \
        const float SW_PhaseSpeed = max(SW_Row1.w, 0.0); \
        const float SW_Lifetime = max(SW_Row2.x, 0.1); \
        const float SW_HalfAngle = clamp(SW_Row2.y, 0.1, 0.7); \
        const float SW_Age = SW_ServerTime - SW_StartTime; \
        if (SW_Amplitude > 0.0 && SW_Age >= 0.0 && SW_Age < SW_Lifetime && SW_Row2.w >= 0.5) \
        { \
            const float2 SW_Right = float2(-SW_Forward.y, SW_Forward.x); \
            const float2 SW_Delta = SW_QueryPosition - SW_Origin; \
            const float SW_Behind = -dot(SW_Delta, SW_Forward); \
            if (SW_Behind > 0.0) \
            { \
                const float SW_Lateral = abs(dot(SW_Delta, SW_Right)); \
                const float SW_RadiusSquared = SW_Behind * SW_Behind + SW_Lateral * SW_Lateral; \
                const float SW_WavefrontRadius = SW_PhaseSpeed * SW_Age; \
                const float SW_EnvelopeWidth = max(SW_WaveLength * 2.75, 1.0); \
                const float SW_MinimumRadius = max(0.0, SW_WavefrontRadius - SW_EnvelopeWidth); \
                const float SW_MaximumRadius = SW_WavefrontRadius + SW_EnvelopeWidth; \
                if (SW_RadiusSquared >= SW_MinimumRadius * SW_MinimumRadius && SW_RadiusSquared <= SW_MaximumRadius * SW_MaximumRadius) \
                { \
                    const float SW_Radius = sqrt(SW_RadiusSquared); \
                    const float SW_Angle = atan2(SW_Lateral, max(SW_Behind, 1.0)); \
                    const float SW_WedgeEdge = SW_HalfAngle + 0.12; \
                    if (SW_Angle < SW_WedgeEdge) \
                    { \
                        const float SW_WedgeMask = 1.0 - smoothstep(SW_HalfAngle, SW_WedgeEdge, SW_Angle); \
                        const float SW_RadialOffset = SW_Radius - SW_WavefrontRadius; \
                        const float SW_NormalizedEnvelope = saturate(abs(SW_RadialOffset) / SW_EnvelopeWidth); \
                        const float SW_RadialEnvelope = 1.0 - smoothstep(0.45, 1.0, SW_NormalizedEnvelope); \
                        const float SW_DivergentAngularWidth = max(SW_HalfAngle * 0.24, 0.035); \
                        const float SW_DivergentAngularOffset = (SW_Angle - SW_HalfAngle) / SW_DivergentAngularWidth; \
                        const float SW_DivergentMask = exp(-SW_DivergentAngularOffset * SW_DivergentAngularOffset); \
                        const float SW_TransverseAngularScale = max(SW_HalfAngle * 0.72, 0.035); \
                        const float SW_TransverseRatio = SW_Angle / SW_TransverseAngularScale; \
                        const float SW_TransverseMask = exp(-pow(SW_TransverseRatio, 4.0)); \
                        const float SW_Phase = (SW_RadialOffset / SW_WaveLength) * (2.0 * SW_SHIP_WAKE_PI); \
                        const float SW_DivergentWave = cos(SW_Phase) * SW_DivergentMask; \
                        const float SW_TransverseWave = cos(SW_Phase * 0.72 + 0.65) * SW_TransverseMask * 0.42; \
                        const float SW_TimeDecay = exp(-SW_Age / max(SW_Lifetime * 0.72, 0.1)); \
                        const float SW_DistanceDecay = rsqrt(1.0 + SW_Radius / (SW_WaveLength * 2.0)); \
                        const float SW_Envelope = SW_WedgeMask * SW_RadialEnvelope * SW_TimeDecay * SW_DistanceDecay; \
                        const float SW_EventHeight = SW_Amplitude * (SW_DivergentWave + SW_TransverseWave) * SW_Envelope; \
                        OUT_HEIGHT += SW_EventHeight; \
                        const float SW_Crest = saturate((SW_EventHeight / max(SW_Amplitude, 1.0) - 0.08) * 5.0); \
                        const float SW_EdgeBreak = saturate(SW_DivergentMask * 1.35 + SW_TransverseMask * 0.25); \
                        OUT_FOAM = saturate(OUT_FOAM + SW_Crest * SW_EdgeBreak * saturate(SW_Envelope * 2.0)); \
                    } \
                } \
            } \
        } \
    } \
    OUT_HEIGHT = clamp(OUT_HEIGHT, -100.0, 100.0); \
}

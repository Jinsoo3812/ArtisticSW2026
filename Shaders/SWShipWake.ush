// M7 fixed Golden Image evaluator. Keep macro-only: Unreal inserts Custom
// include paths inside a generated function, where free functions are illegal.
#pragma once

#define SW_M7_WAKE_CAPACITY 1024
#define SW_M7_GOLDEN_PEAK 1.3871971383

#define SW_M7_EVALUATE_KELVIN(WORLD_XY, SERVER_TIME, EVENT_COUNT, EVENT_TEX, EVENT_SAMPLER, GOLDEN_TEX, GOLDEN_SAMPLER, OUT_HEIGHT) \
{ \
    const float2 SW_Query = (WORLD_XY); \
    const int SW_Count = clamp((int)round(EVENT_COUNT), 0, SW_M7_WAKE_CAPACITY); \
    float SW_TotalHeight = 0.0; \
    [loop] \
    for (int SW_Index = 0; SW_Index < SW_M7_WAKE_CAPACITY; ++SW_Index) \
    { \
        if (SW_Index >= SW_Count) break; \
        const float SW_X = (float(SW_Index) + 0.5) / float(SW_M7_WAKE_CAPACITY); \
        const float4 SW_R0 = Texture2DSampleLevel(EVENT_TEX, EVENT_SAMPLER, float2(SW_X, 0.125), 0.0); \
        const float4 SW_R1 = Texture2DSampleLevel(EVENT_TEX, EVENT_SAMPLER, float2(SW_X, 0.375), 0.0); \
        const float4 SW_R2 = Texture2DSampleLevel(EVENT_TEX, EVENT_SAMPLER, float2(SW_X, 0.625), 0.0); \
        const float4 SW_R3 = Texture2DSampleLevel(EVENT_TEX, EVENT_SAMPLER, float2(SW_X, 0.875), 0.0); \
        \
        const float2 SW_P0 = SW_R0.xy; \
        const float2 SW_P1 = SW_R0.zw; \
        const float SW_T0 = SW_R1.x; \
        const float SW_T1 = max(SW_R1.y, SW_T0); \
        const float SW_Amp = SW_R1.z; \
        const float SW_c = max(SW_R1.w, 1.0); \
        \
        if (SW_Amp <= 0.0 || (SERVER_TIME) < SW_T0 || (SERVER_TIME) >= SW_R2.x) continue; \
        \
        const float SW_DeltaT = max(SW_T1 - SW_T0, 1.0e-4); \
        const float2 SW_V = (SW_P1 - SW_P0) / SW_DeltaT; \
        const float SW_V2 = dot(SW_V, SW_V); \
        const float SW_C2 = SW_c * SW_c; \
        const float2 SW_D = SW_P0 - SW_Query; \
        const float SW_Trem = (float)((SERVER_TIME) - SW_T0); \
        \
        const float SW_A = SW_V2 - SW_C2; \
        const float SW_B = 2.0 * (dot(SW_D, SW_V) + SW_C2 * SW_Trem); \
        const float SW_C = dot(SW_D, SW_D) - SW_C2 * SW_Trem * SW_Trem; \
        \
        float SW_Tau = -1.0; \
        if (abs(SW_A) < 1.0e-5) \
        { \
            if (abs(SW_B) > 1.0e-5) \
            { \
                float SW_LinearTau = -SW_C / SW_B; \
                if (SW_LinearTau >= -1.0e-3 && SW_LinearTau <= SW_DeltaT + 1.0e-3 && SW_LinearTau <= SW_Trem) \
                { \
                    SW_Tau = clamp(SW_LinearTau, 0.0, SW_DeltaT); \
                } \
            } \
        } \
        else \
        { \
            const float SW_Disc = SW_B * SW_B - 4.0 * SW_A * SW_C; \
            if (SW_Disc >= 0.0) \
            { \
                const float SW_SqrtDisc = sqrt(SW_Disc); \
                const float SW_Tau1 = (-SW_B - SW_SqrtDisc) / (2.0 * SW_A); \
                const float SW_Tau2 = (-SW_B + SW_SqrtDisc) / (2.0 * SW_A); \
                const bool bValid1 = (SW_Tau1 >= -1.0e-3 && SW_Tau1 <= SW_DeltaT + 1.0e-3 && SW_Tau1 <= SW_Trem); \
                const bool bValid2 = (SW_Tau2 >= -1.0e-3 && SW_Tau2 <= SW_DeltaT + 1.0e-3 && SW_Tau2 <= SW_Trem); \
                if (bValid1 && bValid2) \
                { \
                    SW_Tau = (SW_Tau1 >= 0.0 && SW_Tau1 <= SW_DeltaT) ? SW_Tau1 : SW_Tau2; \
                } \
                else if (bValid1) \
                { \
                    SW_Tau = clamp(SW_Tau1, 0.0, SW_DeltaT); \
                } \
                else if (bValid2) \
                { \
                    SW_Tau = clamp(SW_Tau2, 0.0, SW_DeltaT); \
                } \
            } \
        } \
        \
        if (SW_Tau < 0.0) continue; \
        \
        const float SW_Alpha = clamp(SW_Tau / SW_DeltaT, 0.0, 1.0); \
        const float SW_Age = SW_Trem - SW_Tau; \
        if (SW_Age < 0.0) continue; \
        \
        const float SW_DecayRate = max(SW_R2.w, 0.0); \
        const float SW_Decay = exp(-SW_DecayRate * SW_Age); \
        if (SW_Decay < 0.001) continue; \
        \
        const float2 SW_Apex = lerp(SW_P0, SW_P1, SW_Alpha); \
        const float SW_Yaw0 = SW_R3.x; \
        const float SW_Yaw1 = SW_R3.y; \
        const float2 SW_Fwd0 = float2(cos(SW_Yaw0), sin(SW_Yaw0)); \
        const float2 SW_Fwd1 = float2(cos(SW_Yaw1), sin(SW_Yaw1)); \
        const float2 SW_Forward = normalize(lerp(SW_Fwd0, SW_Fwd1, SW_Alpha) + float2(1.0e-8, 0.0)); \
        const float2 SW_Right = float2(-SW_Forward.y, SW_Forward.x); \
        \
        const float2 SW_Delta = SW_Query - SW_Apex; \
        const float SW_Downstream = -dot(SW_Delta, SW_Forward); \
        const float SW_Lateral = dot(SW_Delta, SW_Right); \
        \
        const float SW_Length = max(SW_R2.y, 1.0); \
        const float SW_HalfWidth = max(SW_R2.z, 1.0); \
        const float SW_LengthCut = clamp(SW_R3.w > 0.001 ? SW_R3.w : 1.0, 0.01, 1.0); \
        const float SW_WidthCut = 1.0; \
        \
        const float SW_U = SW_Downstream / SW_Length; \
        const float SW_V_signed = SW_Lateral / SW_HalfWidth; \
        \
        float SW_Golden = 0.0; \
        if (SW_U >= 0.0 && SW_U <= SW_LengthCut && abs(SW_V_signed) <= SW_WidthCut) \
        { \
            const float SW_UFadeIn = smoothstep(0.0, 0.03, SW_U); \
            const float SW_UFadeOut = 1.0 - smoothstep(SW_LengthCut * 0.70, SW_LengthCut, SW_U); \
            const float SW_VNorm = abs(SW_V_signed) / SW_WidthCut; \
            const float SW_VFade = 1.0 - smoothstep(0.60, 1.0, SW_VNorm); \
            const float SW_StampMask = SW_UFadeIn * SW_UFadeOut * SW_VFade; \
            if (SW_StampMask > 0.0001) \
            { \
                const float2 SW_GoldenUV = float2(SW_V_signed * 0.5 + 0.5, SW_U); \
                SW_Golden = Texture2DSampleLevel(GOLDEN_TEX, GOLDEN_SAMPLER, SW_GoldenUV, 0.0).r * SW_StampMask; \
            } \
        } \
        \
        const float SW_FadeInSec = SW_R3.z; \
        const float SW_FadeIn = SW_FadeInSec > 1.0e-6 ? smoothstep(0.0, SW_FadeInSec, SW_Age) : 1.0; \
        SW_TotalHeight += SW_Amp * SW_Golden * SW_FadeIn * SW_Decay; \
    } \
    OUT_HEIGHT = clamp(SW_TotalHeight, -200.0, 200.0); \
}

#define SW_M7_EVALUATE_KELVIN_NORMAL(WORLD_XY, SERVER_TIME, EVENT_COUNT, EVENT_TEX, EVENT_SAMPLER, GOLDEN_TEX, GOLDEN_SAMPLER, NORMAL_STRENGTH, OUT_NORMAL) \
{ \
    const float2 SW_Query = (WORLD_XY); \
    const int SW_Count = clamp((int)round(EVENT_COUNT), 0, SW_M7_WAKE_CAPACITY); \
    float2 SW_TotalGradWorld = float2(0.0, 0.0); \
    [loop] \
    for (int SW_Index = 0; SW_Index < SW_M7_WAKE_CAPACITY; ++SW_Index) \
    { \
        if (SW_Index >= SW_Count) break; \
        const float SW_X = (float(SW_Index) + 0.5) / float(SW_M7_WAKE_CAPACITY); \
        const float4 SW_R0 = Texture2DSampleLevel(EVENT_TEX, EVENT_SAMPLER, float2(SW_X, 0.125), 0.0); \
        const float4 SW_R1 = Texture2DSampleLevel(EVENT_TEX, EVENT_SAMPLER, float2(SW_X, 0.375), 0.0); \
        const float4 SW_R2 = Texture2DSampleLevel(EVENT_TEX, EVENT_SAMPLER, float2(SW_X, 0.625), 0.0); \
        const float4 SW_R3 = Texture2DSampleLevel(EVENT_TEX, EVENT_SAMPLER, float2(SW_X, 0.875), 0.0); \
        \
        const float2 SW_P0 = SW_R0.xy; \
        const float2 SW_P1 = SW_R0.zw; \
        const float SW_T0 = SW_R1.x; \
        const float SW_T1 = max(SW_R1.y, SW_T0); \
        const float SW_Amp = SW_R1.z; \
        const float SW_c = max(SW_R1.w, 1.0); \
        \
        if (SW_Amp <= 0.0 || (SERVER_TIME) < SW_T0 || (SERVER_TIME) >= SW_R2.x) continue; \
        \
        const float SW_DeltaT = max(SW_T1 - SW_T0, 1.0e-4); \
        const float2 SW_V = (SW_P1 - SW_P0) / SW_DeltaT; \
        const float SW_V2 = dot(SW_V, SW_V); \
        const float SW_C2 = SW_c * SW_c; \
        const float2 SW_D = SW_P0 - SW_Query; \
        const float SW_Trem = (float)((SERVER_TIME) - SW_T0); \
        \
        const float SW_A = SW_V2 - SW_C2; \
        const float SW_B = 2.0 * (dot(SW_D, SW_V) + SW_C2 * SW_Trem); \
        const float SW_C = dot(SW_D, SW_D) - SW_C2 * SW_Trem * SW_Trem; \
        \
        float SW_Tau = -1.0; \
        if (abs(SW_A) < 1.0e-5) \
        { \
            if (abs(SW_B) > 1.0e-5) \
            { \
                float SW_LinearTau = -SW_C / SW_B; \
                if (SW_LinearTau >= -1.0e-3 && SW_LinearTau <= SW_DeltaT + 1.0e-3 && SW_LinearTau <= SW_Trem) \
                { \
                    SW_Tau = clamp(SW_LinearTau, 0.0, SW_DeltaT); \
                } \
            } \
        } \
        else \
        { \
            const float SW_Disc = SW_B * SW_B - 4.0 * SW_A * SW_C; \
            if (SW_Disc >= 0.0) \
            { \
                const float SW_SqrtDisc = sqrt(SW_Disc); \
                const float SW_Tau1 = (-SW_B - SW_SqrtDisc) / (2.0 * SW_A); \
                const float SW_Tau2 = (-SW_B + SW_SqrtDisc) / (2.0 * SW_A); \
                const bool bValid1 = (SW_Tau1 >= -1.0e-3 && SW_Tau1 <= SW_DeltaT + 1.0e-3 && SW_Tau1 <= SW_Trem); \
                const bool bValid2 = (SW_Tau2 >= -1.0e-3 && SW_Tau2 <= SW_DeltaT + 1.0e-3 && SW_Tau2 <= SW_Trem); \
                if (bValid1 && bValid2) \
                { \
                    SW_Tau = (SW_Tau1 >= 0.0 && SW_Tau1 <= SW_DeltaT) ? SW_Tau1 : SW_Tau2; \
                } \
                else if (bValid1) \
                { \
                    SW_Tau = clamp(SW_Tau1, 0.0, SW_DeltaT); \
                } \
                else if (bValid2) \
                { \
                    SW_Tau = clamp(SW_Tau2, 0.0, SW_DeltaT); \
                } \
            } \
        } \
        \
        if (SW_Tau < 0.0) continue; \
        \
        const float SW_Alpha = clamp(SW_Tau / SW_DeltaT, 0.0, 1.0); \
        const float SW_Age = SW_Trem - SW_Tau; \
        if (SW_Age < 0.0) continue; \
        \
        const float SW_DecayRate = max(SW_R2.w, 0.0); \
        const float SW_Decay = exp(-SW_DecayRate * SW_Age); \
        if (SW_Decay < 0.001) continue; \
        \
        const float2 SW_Apex = lerp(SW_P0, SW_P1, SW_Alpha); \
        const float SW_Yaw0 = SW_R3.x; \
        const float SW_Yaw1 = SW_R3.y; \
        const float2 SW_Fwd0 = float2(cos(SW_Yaw0), sin(SW_Yaw0)); \
        const float2 SW_Fwd1 = float2(cos(SW_Yaw1), sin(SW_Yaw1)); \
        const float2 SW_Forward = normalize(lerp(SW_Fwd0, SW_Fwd1, SW_Alpha) + float2(1.0e-8, 0.0)); \
        const float2 SW_Right = float2(-SW_Forward.y, SW_Forward.x); \
        \
        const float2 SW_Delta = SW_Query - SW_Apex; \
        const float SW_Downstream = -dot(SW_Delta, SW_Forward); \
        const float SW_Lateral = dot(SW_Delta, SW_Right); \
        \
        const float SW_Length = max(SW_R2.y, 1.0); \
        const float SW_HalfWidth = max(SW_R2.z, 1.0); \
        const float SW_LengthCut = clamp(SW_R3.w > 0.001 ? SW_R3.w : 1.0, 0.01, 1.0); \
        const float SW_WidthCut = 1.0; \
        \
        const float SW_U = SW_Downstream / SW_Length; \
        const float SW_V_signed = SW_Lateral / SW_HalfWidth; \
        \
        if (SW_U >= 0.0 && SW_U <= SW_LengthCut && abs(SW_V_signed) <= SW_WidthCut) \
        { \
            const float SW_UFadeIn = smoothstep(0.0, 0.03, SW_U); \
            const float SW_UFadeOut = 1.0 - smoothstep(SW_LengthCut * 0.70, SW_LengthCut, SW_U); \
            const float SW_VNorm = abs(SW_V_signed) / SW_WidthCut; \
            const float SW_VFade = 1.0 - smoothstep(0.60, 1.0, SW_VNorm); \
            const float SW_StampMask = SW_UFadeIn * SW_UFadeOut * SW_VFade; \
            if (SW_StampMask > 0.0001) \
            { \
                const float2 SW_GoldenUV = float2(SW_V_signed * 0.5 + 0.5, SW_U); \
                const float4 SW_GoldenSample = Texture2DSampleLevel(GOLDEN_TEX, GOLDEN_SAMPLER, SW_GoldenUV, 0.0); \
                const float SW_GradU = SW_GoldenSample.g * SW_StampMask; \
                const float SW_GradV = SW_GoldenSample.b * SW_StampMask; \
                const float SW_FadeInSec = SW_R3.z; \
                const float SW_FadeIn = SW_FadeInSec > 1.0e-6 ? smoothstep(0.0, SW_FadeInSec, SW_Age) : 1.0; \
                const float SW_Weight = SW_Amp * SW_FadeIn * SW_Decay; \
                const float SW_dH_dDownstream = (SW_Weight / SW_Length) * SW_GradU; \
                const float SW_dH_dLateral = (SW_Weight / SW_HalfWidth) * SW_GradV; \
                const float2 SW_GradWorld = SW_dH_dDownstream * (-SW_Forward) + SW_dH_dLateral * SW_Right; \
                SW_TotalGradWorld += SW_GradWorld; \
            } \
        } \
    } \
    OUT_NORMAL = normalize(float3(-SW_TotalGradWorld.x * (NORMAL_STRENGTH), -SW_TotalGradWorld.y * (NORMAL_STRENGTH), 1.0)); \
}


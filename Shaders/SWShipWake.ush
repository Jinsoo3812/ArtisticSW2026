// M7 fixed Golden Image evaluator. Keep macro-only: Unreal inserts Custom
// include paths inside a generated function, where free functions are illegal.
#pragma once

#define SW_M7_WAKE_CAPACITY 64
#define SW_M7_GOLDEN_PEAK 1.3871971383

#define SW_M7_EVALUATE_KELVIN(WORLD_XY, SERVER_TIME, EVENT_COUNT, EVENT_TEX, EVENT_SAMPLER, GOLDEN_TEX, GOLDEN_SAMPLER, OUT_HEIGHT) \
{ \
    const float2 SW_Query = (WORLD_XY); \
    const int SW_Count = clamp((int)round(EVENT_COUNT), 0, SW_M7_WAKE_CAPACITY); \
    float SW_WeightedHeight = 0.0; \
    float SW_BlendWeight = 0.0; \
    [loop] \
    for (int SW_Index = 0; SW_Index < SW_M7_WAKE_CAPACITY; ++SW_Index) \
    { \
        if (SW_Index >= SW_Count) break; \
        const float SW_X = (float(SW_Index) + 0.5) / float(SW_M7_WAKE_CAPACITY); \
        const float4 SW_R0 = Texture2DSampleLevel(EVENT_TEX, EVENT_SAMPLER, float2(SW_X, 0.125), 0.0); \
        const float4 SW_R1 = Texture2DSampleLevel(EVENT_TEX, EVENT_SAMPLER, float2(SW_X, 0.375), 0.0); \
        const float4 SW_R2 = Texture2DSampleLevel(EVENT_TEX, EVENT_SAMPLER, float2(SW_X, 0.625), 0.0); \
        const float4 SW_R3 = Texture2DSampleLevel(EVENT_TEX, EVENT_SAMPLER, float2(SW_X, 0.875), 0.0); \
        const float SW_Age = (SERVER_TIME) - SW_R1.x; \
        if (SW_R1.y <= 0.0 || SW_Age < 0.0 || (SERVER_TIME) >= SW_R2.x) continue; \
        const float2 SW_Forward = normalize(SW_R0.zw + float2(1.0e-8, 0.0)); \
        const float2 SW_Right = float2(-SW_Forward.y, SW_Forward.x); \
        const float2 SW_Delta = SW_Query - SW_R0.xy; \
        const float SW_Downstream = -dot(SW_Delta, SW_Forward); \
        const float SW_Lateral = dot(SW_Delta, SW_Right); \
        const float SW_Length = max(SW_R2.y, 1.0); \
        const float SW_HalfWidth = max(SW_R2.z, 1.0); \
        if (SW_Downstream < 0.0 || SW_Downstream > SW_Length || abs(SW_Lateral) > SW_HalfWidth) continue; \
        const float SW_Radius = length(float2(SW_Downstream, SW_Lateral)); \
        const float SW_Front = max(SW_R1.z, 1.0) * SW_Age; \
        const float SW_EnvelopeWidth = max(SW_R2.w, 1.0); \
        const float SW_FrontDistance = abs(SW_Radius - SW_Front); \
        if (SW_FrontDistance >= SW_EnvelopeWidth) continue; \
        const float SW_Envelope = 1.0 - smoothstep(0.0, SW_EnvelopeWidth, SW_FrontDistance); \
        const float SW_FadeIn = SW_R3.x > 1.0e-6 ? smoothstep(0.0, SW_R3.x, SW_Age) : 1.0; \
        const float SW_Weight = SW_Envelope * SW_FadeIn; \
        const float SW_Decay = exp(-max(SW_R1.w, 0.0) * SW_Age); \
        const float2 SW_GoldenUV = float2(SW_Lateral / SW_HalfWidth * 0.5 + 0.5, SW_Downstream / SW_Length); \
        const float SW_Golden = Texture2DSampleLevel(GOLDEN_TEX, GOLDEN_SAMPLER, SW_GoldenUV, 0.0).r; \
        SW_WeightedHeight += SW_R1.y * SW_Golden * SW_Weight * SW_Decay; \
        SW_BlendWeight += SW_Weight; \
    } \
    OUT_HEIGHT = clamp(SW_WeightedHeight / max(SW_BlendWeight, 1.0), -200.0, 200.0); \
}
